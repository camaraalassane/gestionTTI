{
    "$schema": "https://json.schemastore.org/jsconfig",
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["esnext", "dom", "dom.iterable", "scripthost"],
        "checkJs": false,
        "jsx": "preserve",
        "allowJs": true,
        "sourceMap": true,
        "strict": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "5.0", // <--- AJOUTE CETTE LIGNE ICI
        "paths": {
            "@/*": ["./resources/js/*"]
        }
    },
    "include": [
        "resources/js/**/*",
        "resources/js/**/*.vue",
        "resources/js/**/*.d.ts"
    ],
    "exclude": ["node_modules", "public"]
}
